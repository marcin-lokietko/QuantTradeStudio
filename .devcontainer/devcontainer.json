{
	"name": "Quant Trade Studio devcontainer config",
	// Sets the run context to one level up instead of the .devcontainer folder.
	"context": "..",

	// Make the path inside the .devcontainer's container independent from the path on the host machine.
	// The path after /workspace/ should always start with quant-trade-studio, because this is used in scripts (it's same in docker-compose.yml and Dockerfiles).
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/quant-trade-studio,type=bind",
	"workspaceFolder": "/workspaces/quant-trade-studio",

	"dockerFile": "../scripts/backend/Dockerfile",
	"customizations": {
		"vscode": {
			"settings": {},
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"ms-python.python",
				"xaver.clang-format",
				"eamodio.gitlens",
				"github.vscode-github-actions",
				"esbenp.prettier-vscode"
			]
		}
	},
	"forwardPorts": [
		5000
	]
}